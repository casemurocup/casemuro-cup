# ---------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas el archivo `.env` a GitHub.
# ---------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API Keys → anon / public
# Esta clave es pública por diseño (viaja en el navegador). La seguridad
# real la dan las políticas RLS de PostgreSQL, no esta clave.
VITE_SUPABASE_ANON_KEY=

# Email de la cuenta de Supabase que es administradora del torneo.
# Ver `supabase/admin-bootstrap.sql`. La CONTRASEÑA de administrador es la
# de esa cuenta de Supabase y no se pone aquí ni en el código.
VITE_ADMIN_EMAIL=
